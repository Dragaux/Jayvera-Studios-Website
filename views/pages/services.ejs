<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head', { title: 'Services', description: 'What Jayvera Studios builds — web design and development, custom tools and automation, and nonprofit or community platforms.' }) %>
</head>
<body>
<%- include('../partials/header', { active: 'services' }) %>

<%- include('../partials/page-hero', {
  eyebrow: 'What we do',
  pageTitle: 'Three ways we help a business look and work like it means it.',
  lede: 'Every engagement starts with a conversation about what the business actually needs — these are the shapes that conversation usually takes.',
  breadcrumb: 'Services'
}) %>

<section class="services-detail">
  <div class="wrap">
    <% services.forEach((s, i) => { %>
      <div class="service-detail-row">
        <div class="service-detail-num mono">FIG. <%= String(i + 1).padStart(2, '0') %></div>
        <div class="service-detail-body">
          <h2><%= s.title %></h2>
          <p><%= s.description %></p>
        </div>
      </div>
    <% }) %>
  </div>
</section>

<section class="cta-band">
  <div class="wrap cta-band-inner">
    <div>
      <div class="fig"><span class="num">FIG. 04</span><span class="rule"></span><span class="label">Get started</span></div>
      <h2 class="section-title">Not sure which one fits?</h2>
      <p class="lede-dark">That's what the first conversation is for — tell us what you're working with.</p>
    </div>
    <div class="cta-band-links">
      <a href="/contact" class="btn btn-primary">Start a project →</a>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
</body>
</html>
